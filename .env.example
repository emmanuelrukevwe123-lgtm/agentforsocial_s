# Copy to .env (git-ignored). NEVER add ANTHROPIC_API_KEY: it moves Claude Code to paid API billing.

# Where the portfolio keeps profile.json and projects.json (default: ../portfolio/content, then ./content)
PORTFOLIO_CONTENT_DIR=

# common/llm.py back end: claude (Pro subscription via `claude -p`), gemini, or paste
LLM_BACKEND=claude

# Gemini free tier (prompts may be used by Google: never send private data)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional filler footage (stretch item)
PEXELS_API_KEY=
